---
import Lockup from './Lockup.astro';
import { SITE, instagramUrl } from '../data/site';
import { waLink } from '../lib/whatsapp';

const anio = new Date().getFullYear();
---

<footer class="border-t border-line-dark bg-ink">
  <div class="container-site flex flex-col gap-8 pt-12 pb-32 md:flex-row md:items-start md:justify-between md:pb-12">
    <div class="flex flex-col gap-4">
      <a href="/" aria-label="MetalMind Studios — inicio" class="w-fit text-bone">
        <Lockup tamano={30} />
      </a>
      <p class="max-w-[36ch] text-sm leading-relaxed text-graphite">
        Diseñado y construido por una persona. Esa persona te contesta el WhatsApp.
      </p>
    </div>

    <div class="flex flex-col gap-3 text-[0.9375rem]">
      <a href={waLink('footer')} class="link-coral w-fit text-steel hover:text-bone">
        WhatsApp {SITE.whatsappDisplay}
      </a>
      <a href={`mailto:${SITE.correo}`} class="link-coral w-fit text-steel hover:text-bone">
        {SITE.correo}
      </a>
      <a
        href={instagramUrl}
        rel="me noopener"
        class="link-coral w-fit text-steel hover:text-bone"
      >
        Instagram @{SITE.instagram}
      </a>
      <p class="mt-2 text-sm text-graphite">{SITE.origen} · {anio}</p>
    </div>
  </div>
</footer>
