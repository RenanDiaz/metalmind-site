---
import Lockup from './Lockup.astro';
import { SITE } from '../data/site';
import { waLink } from '../lib/whatsapp';

const anio = new Date().getFullYear();
---

<footer class="border-t border-line-dark bg-ink">
  <div class="container-site flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div class="flex flex-col gap-4">
      <a href="/" aria-label="MetalMind Studios — inicio" class="w-fit text-bone">
        <Lockup tamano={30} />
      </a>
      <p class="max-w-[36ch] text-sm leading-relaxed text-graphite">
        Diseñado y construido por una persona. Esa persona te contesta el WhatsApp.
      </p>
    </div>

    <div class="flex flex-col gap-3 text-[0.9375rem]">
      <a href={waLink('footer')} class="link-coral w-fit text-steel hover:text-bone">
        WhatsApp {SITE.whatsappDisplay}
      </a>
      <a href={`mailto:${SITE.correo}`} class="link-coral w-fit text-steel hover:text-bone">
        {SITE.correo}
      </a>
      {
        /* TODO: activar cuando se confirme el handle de Instagram
        <a href={`https://instagram.com/${SITE.instagram}`} class="link-coral w-fit text-steel hover:text-bone">
          Instagram
        </a> */
      }
      <p class="mt-2 text-sm text-graphite">{SITE.ubicacion} · {anio}</p>
    </div>
  </div>
</footer>
