---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import MarcoNavegador from './MarcoNavegador.astro';

interface Props {
  trabajo: CollectionEntry<'trabajos'>;
}
const { trabajo } = Astro.props;
const { nombre, problema, resultado, captura, capturaAlt, esDemo, sector } = trabajo.data;
const url = `/trabajos/${trabajo.id}`;
---

<article class="flex h-full flex-col">
  <a href={url} tabindex="-1" aria-hidden="true">
    <MarcoNavegador>
      <Picture
        src={captura}
        alt={capturaAlt}
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 350px, 92vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="aspect-4/3 w-full object-cover object-top"
      />
    </MarcoNavegador>
  </a>
  <div class="mt-5 flex items-baseline gap-3">
    <h3 class="display-3 text-ink">
      <a href={url} class="decoration-coral underline-offset-4 hover:underline">{nombre}</a>
    </h3>
    {esDemo && <span class="eyebrow shrink-0 text-graphite-deep">Proyecto demo</span>}
  </div>
  <p class="eyebrow mt-2 text-graphite-deep">{sector}</p>
  <p class="mt-3 text-[0.9375rem] leading-relaxed text-graphite-deep">{problema}</p>
  <p class="mt-2 text-[0.9375rem] leading-relaxed font-medium text-ink">{resultado}</p>
  <p class="mt-4">
    <a href={url} class="link-coral text-[0.9375rem] font-medium text-ink">Ver el caso →</a>
  </p>
</article>
