---
import { PROCESO } from '../data/home';

/**
 * El elemento firma del sitio: el cubo del logo desdoblado en el tiempo.
 * Desktop: los pasos bajan en escalera; de cada nodo cae una vertical
 * (la vertical también es arista del hexágono) que libra el bloque de
 * texto, y de su pie sale el tramo a 30° exactos hasta el nodo siguiente
 * (caída = 104px, dx = 104·√3, hipotenusa = 208px). Recto nodo-a-nodo el
 * tramo atravesaría el párrafo: el texto (52ch) es más ancho que dx.
 * Móvil y tablet: eje vertical. Línea 1px graphite, nodo coral por paso.
 * Estático a propósito: el motion del sitio se gasta una sola vez, en el
 * hexágono del hero.
 */
---

<ol class="eje">
  {
    PROCESO.pasos.map((paso, i) => (
      <li>
        <span class="nodo" aria-hidden="true" />
        <p class="eyebrow text-graphite">
          0{i + 1} · {paso.tiempo}
        </p>
        <h3 class="display-3 mt-2 text-bone">{paso.nombre}</h3>
        <p class="mt-1.5 max-w-[52ch] text-sm leading-normal text-steel">{paso.texto}</p>
      </li>
    ))
  }
</ol>

<style>
  .eje {
    position: relative;
  }
  /* Móvil: eje vertical continuo */
  .eje::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background-color: var(--color-graphite);
  }
  .eje li {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 2.5rem;
  }
  .eje li:last-child {
    padding-bottom: 0;
  }
  .nodo {
    position: absolute;
    left: 0;
    top: 4px;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background-color: var(--color-coral);
    z-index: 1;
  }

  /* Desktop: escalera vertical + 30°. En md la escalera no cabe
     (3·dx = 540px dejan al último paso sin ancho), así que entra en lg. */
  @media (width >= 64rem) {
    .eje {
      --caida: 104px; /* caída vertical del tramo a 30° */
      --dx: 180.13px; /* 104·√3 → tramo a 30° exactos */
      --hyp: 208px; /* caída / sin(30°) */
      --vertical: 104px; /* baja del nodo por debajo del texto (~96px) */
      --rise: 208px; /* vertical + caída: alto de cada paso */
    }
    .eje::before {
      display: none;
    }
    .eje li {
      height: var(--rise);
      padding-bottom: 0;
      margin-left: calc(var(--n, 0) * var(--dx));
    }
    .eje li:nth-child(2) {
      --n: 1;
    }
    .eje li:nth-child(3) {
      --n: 2;
    }
    .eje li:nth-child(4) {
      --n: 3;
    }
    .eje li:last-child {
      height: auto;
    }
    /* Vertical que cae del nodo, a la izquierda del texto */
    .eje li:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 5px;
      top: 9.5px;
      width: 1px;
      height: var(--vertical);
      background-color: var(--color-graphite);
    }
    /* Tramo a 30° desde el pie de la vertical anterior hasta este nodo */
    .eje li + li::before {
      content: '';
      position: absolute;
      left: calc(5.5px - var(--dx));
      top: calc(9.5px - var(--caida));
      width: var(--hyp);
      height: 1px;
      background-color: var(--color-graphite);
      transform: rotate(30deg);
      transform-origin: left center;
    }
  }
</style>
