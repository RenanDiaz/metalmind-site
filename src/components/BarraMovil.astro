---
import { waLink } from '../lib/whatsapp';
---

{/*
  Barra fija inferior en móvil con el CTA de WhatsApp siempre a mano.
  Se oculta solo mientras el CTA del hero está en pantalla, para no tener
  dos botones coral idénticos apilados (regla: un CTA coral por pantalla).
  Sin JS, la barra queda visible siempre — degradación correcta.
*/}
<div
  id="barra-movil"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line-dark bg-ink px-4 pt-3 md:hidden"
  style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom))"
>
  <a href={waLink('barra-movil')} class="btn-primary w-full">Cotizar por WhatsApp</a>
</div>

<style>
  #barra-movil {
    transition: transform 200ms ease;
  }
  #barra-movil.oculta {
    transform: translateY(100%);
  }
</style>

<script>
  const barra = document.getElementById('barra-movil');
  const heroCta = document.getElementById('hero-cta');
  if (barra && heroCta && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      ([entrada]) => {
        barra.classList.toggle('oculta', entrada?.isIntersecting ?? false);
      },
      { threshold: 0.5 }
    );
    observador.observe(heroCta);
  }
</script>
