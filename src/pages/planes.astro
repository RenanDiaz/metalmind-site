---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaPlan from '../components/TarjetaPlan.astro';
import FaqLista from '../components/FaqLista.astro';
import SeparadorArista from '../components/SeparadorArista.astro';
import { serviciosJsonLd, faqJsonLd } from '../lib/jsonld';
import { PAGINA_PLANES } from '../data/paginas';
import { FAQ_INTRO } from '../data/home';

const planes = (await getCollection('planes')).sort((a, b) => a.data.orden - b.data.orden);
const detalles = await Promise.all(
  planes.map(async (plan) => ({ plan, Contenido: (await render(plan)).Content }))
);

const faqEntradas = (await getCollection('faq')).sort((a, b) => a.data.orden - b.data.orden);
const faqParaJsonLd = faqEntradas.map((entrada) => ({
  pregunta: entrada.data.pregunta,
  respuesta: (entrada.body ?? '').replace(/\s+/g, ' ').trim(),
}));
---

<Base
  title={PAGINA_PLANES.metaTitle}
  description={PAGINA_PLANES.metaDescription}
  ogImage="/og/planes.png"
  jsonLd={[
    serviciosJsonLd(planes.map((p) => p.data)),
    faqJsonLd(faqParaJsonLd),
  ]}
>
  <section class="bg-ink">
    <div class="container-site pt-14 pb-16 md:pt-20 md:pb-24">
      <h1 class="display-1 text-bone">{PAGINA_PLANES.titulo}</h1>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-steel">{PAGINA_PLANES.intro}</p>
    </div>
  </section>

  <SeparadorArista de="ink" a="bone" />

  <section class="bg-bone" aria-label="Planes">
    <div class="container-site py-16 md:py-24">
      <div class="grid gap-6 md:grid-cols-3">
        {planes.map((plan) => <TarjetaPlan plan={plan} nivelTitulo="h2" />)}
      </div>

      {/* Detalle extendido de cada plan */}
      <div class="mt-16 grid gap-10 md:mt-20 md:grid-cols-3 md:gap-8">
        {
          detalles.map(({ plan, Contenido }) => (
            <div class="border-t border-line-light pt-5">
              <h2 class="display-3 text-ink">Plan {plan.data.nombre}, en detalle</h2>
              <div class="prose-plan mt-3">
                <Contenido />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-bone" aria-labelledby="mantenimiento-titulo">
    <div class="container-site pb-16 md:pb-24">
      <div class="grid gap-10 border-t border-line-light pt-12 md:grid-cols-2 md:gap-8">
        <div>
          <h2 id="mantenimiento-titulo" class="display-3 text-ink">
            {PAGINA_PLANES.mantenimiento.titulo}
          </h2>
          <ul class="mt-5 flex flex-col gap-3 text-[0.9375rem] leading-relaxed text-graphite-deep">
            {
              PAGINA_PLANES.mantenimiento.items.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-[10px] h-px w-3 shrink-0 bg-graphite-deep" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="display-3 text-ink">{PAGINA_PLANES.teToca.titulo}</h2>
          <p class="mt-5 text-[0.9375rem] leading-relaxed text-graphite-deep">
            {PAGINA_PLANES.teToca.intro}
          </p>
          <ul class="mt-3 flex flex-col gap-3 text-[0.9375rem] leading-relaxed text-graphite-deep">
            {
              PAGINA_PLANES.teToca.items.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-[10px] h-px w-3 shrink-0 bg-graphite-deep" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bone" aria-labelledby="faq-titulo">
    <div class="container-site max-w-4xl pb-18 md:pb-32">
      <p class="eyebrow text-graphite-deep">{FAQ_INTRO.eyebrow}</p>
      <h2 id="faq-titulo" class="display-2 mt-4 text-ink">{FAQ_INTRO.titulo}</h2>
      <div class="mt-10">
        <FaqLista />
      </div>
    </div>
  </section>
</Base>

<style>
  .prose-plan :global(p) {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-graphite-deep);
  }
</style>
