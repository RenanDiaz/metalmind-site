---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaTrabajo from '../../components/TarjetaTrabajo.astro';
import SeparadorArista from '../../components/SeparadorArista.astro';
import { waLink } from '../../lib/whatsapp';
import { PAGINA_TRABAJOS } from '../../data/paginas';

const trabajos = (await getCollection('trabajos', ({ data }) => data.publicado)).sort(
  (a, b) => a.data.orden - b.data.orden
);
---

<Base
  title={PAGINA_TRABAJOS.metaTitle}
  description={PAGINA_TRABAJOS.metaDescription}
  ogImage="/og/trabajos.png"
>
  <section class="bg-ink">
    <div class="container-site pt-14 pb-16 md:pt-20 md:pb-24">
      <h1 class="display-1 text-bone">{PAGINA_TRABAJOS.titulo}</h1>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-steel">{PAGINA_TRABAJOS.intro}</p>
    </div>
  </section>

  <SeparadorArista de="ink" a="bone" />

  <section class="bg-bone">
    <div class="container-site py-16 md:py-24">
      <div class="grid gap-12 md:grid-cols-3 md:gap-8">
        {trabajos.map((trabajo) => <TarjetaTrabajo trabajo={trabajo} />)}
      </div>
    </div>
  </section>

  <SeparadorArista de="bone" a="ink" />

  <section class="bg-ink">
    <div class="container-site py-16 md:py-24">
      <h2 class="display-2 max-w-[24ch] text-bone">{PAGINA_TRABAJOS.ctaTitulo}</h2>
      <p class="mt-7">
        <a href={waLink('trabajos')} class="btn-primary">{PAGINA_TRABAJOS.cta}</a>
      </p>
    </div>
  </section>
</Base>
