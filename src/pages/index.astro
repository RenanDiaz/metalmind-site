---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hexagono from '../components/Hexagono.astro';
import SeparadorArista from '../components/SeparadorArista.astro';
import TarjetaPlan from '../components/TarjetaPlan.astro';
import TarjetaTrabajo from '../components/TarjetaTrabajo.astro';
import EjeProceso from '../components/EjeProceso.astro';
import FaqLista from '../components/FaqLista.astro';
import { waLink } from '../lib/whatsapp';
import { negocioJsonLd } from '../lib/jsonld';
import { SITE } from '../data/site';
import {
  HERO,
  PROBLEMA,
  QUE_HAGO,
  PLANES_INTRO,
  PROCESO,
  TRABAJOS_INTRO,
  FAQ_INTRO,
  CIERRE,
} from '../data/home';

const planes = (await getCollection('planes')).sort((a, b) => a.data.orden - b.data.orden);
const trabajos = (await getCollection('trabajos', ({ data }) => data.publicado)).sort(
  (a, b) => a.data.orden - b.data.orden
);
---

<Base
  title="MetalMind Studios — Sitios web para negocios que ya funcionan"
  description={SITE.descripcion}
  ogImage="/og/home.png"
  jsonLd={[negocioJsonLd()]}
>
  {/* 1 · Hero */}
  <section class="bg-ink">
    <div class="container-site pt-16 pb-20 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-16 md:pt-24 md:pb-28">
      <div>
        <p class="eyebrow text-graphite">{HERO.eyebrow}</p>
        <h1 class="display-1 mt-5 text-bone">
          {HERO.titulo[0]}
          <br />
          {HERO.titulo[1]}
        </h1>
        <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-steel">{HERO.subtitulo}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a id="hero-cta" href={waLink('hero')} class="btn-primary">{HERO.ctaPrimario}</a>
          <a href="/trabajos" class="link-coral font-medium text-steel hover:text-bone"
            >{HERO.ctaSecundario}</a
          >
        </div>
      </div>
      <Hexagono animado class="mt-14 block w-44 md:mt-0 md:w-[280px] lg:w-[340px]" />
    </div>
  </section>

  {/* 2 · El problema */}
  <section class="bg-ink" aria-labelledby="problema-titulo">
    <div class="container-site pt-6 pb-18 md:pt-10 md:pb-32">
      <p class="eyebrow text-graphite">{PROBLEMA.eyebrow}</p>
      <h2 id="problema-titulo" class="display-2 mt-4 max-w-[24ch] text-bone">{PROBLEMA.titulo}</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          PROBLEMA.items.map((item, i) => (
            <div class="border-t border-line-dark pt-5">
              <p class="eyebrow text-graphite">0{i + 1}</p>
              <p class="mt-4 text-lg leading-snug font-semibold text-bone">{item.afirmacion}</p>
              <p class="mt-3 leading-relaxed text-steel">{item.consecuencia}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SeparadorArista de="ink" a="bone" />

  {/* 3 · Qué hago */}
  <section class="bg-bone" aria-labelledby="quehago-titulo">
    <div class="container-site py-18 md:py-32">
      <p class="eyebrow text-graphite-deep">{QUE_HAGO.eyebrow}</p>
      <h2 id="quehago-titulo" class="display-2 mt-4 max-w-[26ch] text-ink">{QUE_HAGO.titulo}</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          QUE_HAGO.items.map((item, i) => (
            <div class="border-t border-line-light pt-5">
              <p class="eyebrow text-graphite-deep">0{i + 1}</p>
              <h3 class="display-3 mt-4 text-ink">{item.nombre}</h3>
              <p class="mt-3 leading-relaxed text-graphite-deep">{item.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4 · Planes */}
  <section class="bg-bone" aria-labelledby="planes-titulo">
    <div class="container-site pb-18 md:pb-32">
      <p class="eyebrow text-graphite-deep">{PLANES_INTRO.eyebrow}</p>
      <h2 id="planes-titulo" class="display-2 mt-4 text-ink">{PLANES_INTRO.titulo}</h2>
      <p class="mt-4 max-w-[58ch] leading-relaxed text-graphite-deep">{PLANES_INTRO.intro}</p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {planes.map((plan) => <TarjetaPlan plan={plan} />)}
      </div>
      <div class="mt-10 max-w-[75ch] border border-line-light p-6 md:p-7">
        <h3 class="display-3 text-ink">{PLANES_INTRO.mantenimiento.titulo}</h3>
        <p class="mt-3 leading-relaxed text-graphite-deep">{PLANES_INTRO.mantenimiento.texto}</p>
        <p class="mt-4">
          <a href="/planes" class="link-coral font-medium text-ink">Ver los planes en detalle →</a>
        </p>
      </div>
    </div>
  </section>

  <SeparadorArista de="bone" a="ink" />

  {/* 5 · Proceso — aquí vive el eje isométrico */}
  <section class="bg-ink" aria-labelledby="proceso-titulo">
    <div class="container-site py-18 md:py-32">
      <p class="eyebrow text-graphite">{PROCESO.eyebrow}</p>
      <h2 id="proceso-titulo" class="display-2 mt-4 max-w-[24ch] text-bone">{PROCESO.titulo}</h2>
      <div class="mt-14 md:mt-20">
        <EjeProceso />
      </div>
    </div>
  </section>

  <SeparadorArista de="ink" a="bone" />

  {/* 6 · Trabajos */}
  <section class="bg-bone" aria-labelledby="trabajos-titulo">
    <div class="container-site py-18 md:py-32">
      <p class="eyebrow text-graphite-deep">{TRABAJOS_INTRO.eyebrow}</p>
      <h2 id="trabajos-titulo" class="display-2 mt-4 text-ink">{TRABAJOS_INTRO.titulo}</h2>
      <div class="mt-12 grid gap-12 md:grid-cols-3 md:gap-8">
        {trabajos.map((trabajo) => <TarjetaTrabajo trabajo={trabajo} />)}
      </div>
      <p class="mt-12">
        <a href="/trabajos" class="link-coral font-medium text-ink">{TRABAJOS_INTRO.verTodos} →</a>
      </p>
    </div>
  </section>

  {/* 7 · FAQ */}
  <section class="bg-bone" aria-labelledby="faq-titulo">
    <div class="container-site max-w-4xl pb-18 md:pb-32">
      <p class="eyebrow text-graphite-deep">{FAQ_INTRO.eyebrow}</p>
      <h2 id="faq-titulo" class="display-2 mt-4 text-ink">{FAQ_INTRO.titulo}</h2>
      <div class="mt-10">
        <FaqLista />
      </div>
    </div>
  </section>

  <SeparadorArista de="bone" a="ink" />

  {/* 8 · Cierre */}
  <section class="relative overflow-hidden bg-ink" aria-labelledby="cierre-titulo">
    <Hexagono
      tenue
      conNodo={false}
      class="pointer-events-none absolute -right-16 -bottom-24 w-[340px] md:-right-8 md:w-[460px]"
    />
    <div class="container-site relative py-20 md:py-36">
      <h2 id="cierre-titulo" class="display-2 max-w-[20ch] text-bone">{CIERRE.titulo}</h2>
      <p class="mt-4 max-w-[44ch] text-lg leading-relaxed text-steel">{CIERRE.linea}</p>
      <p class="mt-8">
        <a href={waLink('cierre')} class="btn-primary">{CIERRE.cta}</a>
      </p>
    </div>
  </section>
</Base>
